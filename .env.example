# Copy this file to .env and fill in real values before deploying
# Generate a password hash by running: node hash-password.js "yourpassword"
APP_PASSWORD_HASH=
SESSION_SECRET=change-this-to-a-random-long-string
PORT=3000

# Tax rate assumptions - adjust as needed
SE_TAX_RATE=0.153
SE_TAXABLE_FRACTION=0.9235
FEDERAL_RATE=0.12
STATE_RATE=0.0425
MILEAGE_RATE=0.76
